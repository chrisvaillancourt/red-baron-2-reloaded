{
  "name": "red-baron-2-reloaded",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && vite build",
    "test": "vitest run && pnpm test:tools",
    "test:unit": "vitest run",
    "test:related": "vitest related --run --passWithNoTests=false",
    "test:tools": "node --test tools/dev/*.test.mjs",
    "test:watch": "vitest --watch",
    "e2e": "playwright test",
    "e2e:soak": "E2E_SOAK=1 playwright test tests/e2e/soak.spec.ts",
    "prodcheck": "node tools/playtest/prodcheck.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
